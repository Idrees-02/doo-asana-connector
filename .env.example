# =============================================================================
# DOO Asana Connector — environment configuration
#
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
#
#   cp .env.example .env
#
# NOTE: The app runs perfectly fine with NO .env file at all — it boots into
# DEMO MODE with synthetic data. You only need this file for live Asana data.
# =============================================================================

# -----------------------------------------------------------------------------
# Mode
# -----------------------------------------------------------------------------
# "live"  — talk to the real Asana API (requires credentials below)
# "demo"  — synthetic in-memory data, clearly labelled in the UI
# "auto"  — (default) live if credentials are present, otherwise demo
ASANA_MODE=auto

# -----------------------------------------------------------------------------
# Option A — Personal Access Token (simplest; recommended to start)
# -----------------------------------------------------------------------------
# Create at: https://app.asana.com/0/my-apps  ->  "Create new token"
# Asana shows the token exactly ONCE. Format: 1/1234567890123456:abcdef0123...
ASANA_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Option B — OAuth 2.0 (multi-user; optional)
# -----------------------------------------------------------------------------
# Create at: https://app.asana.com/0/my-apps  ->  "Create new app"
# Set the app's redirect URI to exactly the value of ASANA_OAUTH_REDIRECT_URI.
ASANA_OAUTH_CLIENT_ID=
ASANA_OAUTH_CLIENT_SECRET=
ASANA_OAUTH_REDIRECT_URI=http://localhost:8787/api/auth/oauth/callback

# Least-privilege scopes. Do not add ":delete" scopes — this connector never
# deletes anything, because delete is not one of its five assigned actions.
ASANA_OAUTH_SCOPES=projects:read tasks:read tasks:write stories:write users:read workspaces:read

# -----------------------------------------------------------------------------
# Optional defaults
# -----------------------------------------------------------------------------
# Default workspace GID. If unset and your account has exactly one workspace,
# the connector resolves it automatically.
ASANA_DEFAULT_WORKSPACE=

# -----------------------------------------------------------------------------
# Client tuning
# -----------------------------------------------------------------------------
# Asana allows 150 req/min on free plans and 1500 on paid. We throttle just
# under the free-tier floor by default. Raise this only if you are on a paid plan.
ASANA_RATE_LIMIT_RPM=140

# Per-request timeout in milliseconds.
ASANA_TIMEOUT_MS=15000

# Max concurrent in-flight requests (Asana caps at 50 GET / 15 write).
ASANA_MAX_CONCURRENCY=8

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=8787
NODE_ENV=development

# Interface the HTTP server binds to. SECURITY-RELEVANT: a non-loopback bind
# makes /mcp reachable from off-box, and the connector then REFUSES TO START
# without MCP_AUTH_TOKEN. Blank picks the right default for the environment —
# 127.0.0.1 in development (so `npm run dev` does not publish the API to your
# local network) and 0.0.0.0 in production (so a container's proxy can reach
# it). Set it explicitly only if you know you need to.
HOST=

# Origin allowed to call the API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# This deployment's public origin, e.g. https://your-app.up.railway.app.
# The console prints <origin>/mcp as the MCP endpoint on the MCP page. Blank =>
# it falls back to whatever origin the console was loaded from.
PUBLIC_BASE_URL=

# 32-byte hex key used to encrypt OAuth tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank to keep credentials in memory only (lost on restart).
CREDENTIAL_ENCRYPTION_KEY=

# Log level: error | warn | info | debug
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Assistant (optional)
# -----------------------------------------------------------------------------
# The console's assistant turns plain language into connector actions. Without
# a key the console still runs and simply hides the assistant.
#
# Create at: https://console.groq.com/keys
GROQ_API_KEY=
# Any tool-calling model. The default is a good balance of speed and accuracy.
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# MCP endpoint protection (MANDATORY in production — the server FAILS TO START
# without it)
# -----------------------------------------------------------------------------
# /mcp executes real connector actions using THIS SERVER'S Asana credential.
# Deployed without a token, anyone who learns the URL can drive the workspace.
#
# Blank does NOT mean "unauthenticated". The resolved behaviour is:
#
#   NODE_ENV=production, no token            -> STARTUP ERROR
#   non-loopback HOST, no token              -> STARTUP ERROR
#   loopback + development + no token        -> a random token is generated for
#                                               the process and printed to
#                                               stderr at startup (secure by
#                                               default, zero configuration)
#   loopback + development + the flag below  -> genuinely unauthenticated
#
# Minimum length is 16 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=

# Run the LOCAL /mcp endpoint with no authentication at all.
#
# Honoured only on a loopback bind outside production. Setting it in production,
# or alongside a non-loopback HOST, is a STARTUP ERROR rather than a silently
# ignored value — so it cannot be switched on in a deployment by accident.
# Leave it unset unless you have a reason.
MCP_ALLOW_UNAUTHENTICATED=

# Hosts /mcp will answer to, comma-separated. Usually unnecessary — the list is
# derived from CORS_ORIGIN. Set it when the endpoint is reached on a name the
# console is not served from, otherwise the host check answers 403.
MCP_ALLOWED_HOSTS=

# -----------------------------------------------------------------------------
# Idempotency
# -----------------------------------------------------------------------------
# Where used idempotency keys are recorded, so a deliberate retry of a write
# replays the original result instead of creating a duplicate.
#
#   memory  (default)  process-local; cleared on restart
#   file               written to IDEMPOTENCY_FILE (mode 0600); survives a
#                      restart when the path is on a persistent volume
#
# NEITHER coordinates across instances. A multi-replica deployment needs a
# shared backend — the storage layer is an interface so one can be added, and
# none is claimed to exist today. See docs/WRITE-SAFETY.md.
IDEMPOTENCY_STORE=memory
IDEMPOTENCY_FILE=.idempotency/records.json

# How long a key is remembered, in milliseconds. Default 15 minutes.
IDEMPOTENCY_TTL_MS=900000
